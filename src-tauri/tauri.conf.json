{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Track",
  "version": "0.2.8",
  "identifier": "app.track.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Track",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 420,
        "center": true,
        "transparent": true,
        "decorations": false,
        "resizable": true,
        "visible": false,
        "shadow": true,
        "dragDropEnabled": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "Every terminal you run, in one calm window",
    "longDescription": "Track holds up to sixteen terminals per screen, across as many screens as you like, and tells you when one of them needs you.",
    "windows": {
      "nsis": { "installMode": "currentUser", "installerIcon": "icons/icon.ico" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/ManyGlue0/Track/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
